# Copy to .env for local Docker Compose use. These are synthetic local placeholders.
DB_OWNER_PASSWORD=replace-with-local-owner-password
DB_APP_PASSWORD=replace-with-local-app-password

APP_SETUP_PROJECT_ID=30000000-0000-0000-0000-000000000001

# Generate each value locally: htpasswd -bnBC 12 '' 'a-local-password' | tr -d ':\n'. In this Compose env file, replace each `$` in the hash with `$$`.
APP_SECURITY_CERTIFIER_PASSWORD_HASH=replace-with-bcrypt-hash
APP_SECURITY_ACCOUNTS_PASSWORD_HASH=replace-with-bcrypt-hash
APP_SECURITY_MANAGER_PASSWORD_HASH=replace-with-bcrypt-hash
